{
  "manifest_version": 3,
  "name": "Infinite Arcade Pong",
  "version": "0.2.0",
  "description": "A neon arcade-style Pong game in a Chrome extension popup.",
  "action": {
    "default_popup": "src/popup.html"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
